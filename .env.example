# Copy to .env for the Compose test database. Replace change-me before first start.
POSTGRES_USER=kk
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# Used by psql clients, the checkout tests, and the reconciliation app.
# Keep the host port and credentials in sync with the settings above.
# Percent-encode special characters in the URL's username or password.
DATABASE_URL=postgresql://kk:change-me@127.0.0.1:5433/kloudkart
